{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",
    "no-unused-vars": ["error", { "ignoreRestSiblings": true }],
    "import/no-unassigned-import": "off",
    "no-await-in-loop": "off",
    "no-underscore-dangle": "off",
    "no-shadow": "off",

    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/prefer-tag-over-role": "off",

    "react/purity": "off",
    "react/refs": "off",
    "react/use-memo": "off",
    "react/exhaustive-effect-dependencies": "off"
  },
  "overrides": [
    {
      "files": ["src/core/**", "src/game/**", "src/storage/**"],
      "rules": { "react-hooks/rules-of-hooks": "off" }
    },
    {
      "files": ["src/ui/components/Modal.tsx"],
      "rules": {
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/no-static-element-interactions": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "e2e/**"],
      "rules": { "react/no-children-prop": "off" }
    }
  ],
  "ignorePatterns": ["dist", "node_modules", "test-results", "coverage"]
}
